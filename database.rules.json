{
  "rules": {
    ".read": false, ".write": false,
    "users": { ".read": true, "$uid": { ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')", ".validate": "newData.hasChildren(['uid','username','displayName']) && newData.child('uid').val() === $uid" } },
    "usernames": { ".read": true, "$username": { ".write": "auth != null && (!data.exists() || data.val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')" } },
    "posts": { ".read": true, ".indexOn": ["createdAt","authorId","replyTo"], "$postId": { ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || data.child('authorId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')", ".validate": "!newData.exists() || (newData.hasChildren(['authorId','text','createdAt','counts']) && newData.child('text').isString() && newData.child('text').val().length <= 280)" } },
    "likes": { "$postId": { "$uid": { ".read": true, ".write": "auth != null && auth.uid === $uid" } } },
    "reposts": { "$postId": { "$uid": { ".read": true, ".write": "auth != null && auth.uid === $uid" } } },
    "bookmarks": { "$postId": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" } } },
    "likesByUser": { "$uid": { ".read": "auth != null && auth.uid === $uid", "$postId": { ".write": "auth != null && auth.uid === $uid" } } },
    "repostsByUser": { "$uid": { ".read": "auth != null && auth.uid === $uid", "$postId": { ".write": "auth != null && auth.uid === $uid" } } },
    "bookmarksByUser": { "$uid": { ".read": "auth != null && auth.uid === $uid", "$postId": { ".write": "auth != null && auth.uid === $uid" } } },
    "following": { "$uid": { ".read": true, "$target": { ".write": "auth != null && auth.uid === $uid" } } },
    "followers": { "$uid": { ".read": true, "$follower": { ".write": "auth != null && auth.uid === $follower" } } },
    "conversationsByUser": { "$uid": { ".read": "auth != null && auth.uid === $uid", "$id": { ".write": "auth != null && (auth.uid === $uid || root.child('conversations').child($id).child('members').child(auth.uid).val() === true)" } } },
    "conversations": { "$id": { ".read": "auth != null && data.child('members').child(auth.uid).val() === true", ".write": "auth != null && (data.child('members').child(auth.uid).val() === true || newData.child('members').child(auth.uid).val() === true)" } },
    "messages": { "$id": { ".read": "auth != null && root.child('conversations').child($id).child('members').child(auth.uid).val() === true", ".indexOn": ["createdAt"], "$messageId": { ".write": "auth != null && root.child('conversations').child($id).child('members').child(auth.uid).val() === true && newData.child('senderId').val() === auth.uid" } } },
    "notifications": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".indexOn": ["createdAt"], "$id": { ".write": "auth != null && (auth.uid === $uid || newData.child('actorId').val() === auth.uid)" } } },
    "reports": { "$id": { ".write": "auth != null && newData.child('reporterId').val() === auth.uid", ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" } }
  }
}
